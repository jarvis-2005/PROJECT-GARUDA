# =========================================================
# PHASE 4 — GET NEXT DRONE MISSION
# =========================================================

@app.route("/drone/mission", methods=["GET"])
def get_drone_mission():
    conn = get_connection()

    try:
        cursor = conn.cursor()

        cursor.execute("""
            SELECT id, gate, status, time
            FROM events
            WHERE drone_status = 'PENDING'
            ORDER BY id ASC
            LIMIT 1
        """)

        row = cursor.fetchone()

        if row is None:
            return jsonify({"mission": None})

        event_id = row["id"]
        gate = row["gate"]
        status = row["status"]
        event_time = row["time"]

        gate_text = str(gate).upper()
        status_text = str(status).upper()

        if "1" in gate_text:
            gate_number = 1
        elif "2" in gate_text:
            gate_number = 2
        elif "3" in gate_text:
            gate_number = 3
        else:
            return jsonify({
                "mission": None,
                "message": "Gate is not recognized"
            })

        eligible_statuses = (
            "OPEN",
            "TRIGGER",
            "INTRUSION",
            "ALERT"
        )

        if not any(
            word in status_text
            for word in eligible_statuses
        ):
            return jsonify({
                "mission": None,
                "message": "Event is not an eligible alert"
            })

        cursor.execute("""
            UPDATE events
            SET drone_status = 'DISPATCHED'
            WHERE id = ? AND drone_status = 'PENDING'
        """, (event_id,))

        if cursor.rowcount != 1:
            conn.rollback()
            return jsonify({"mission": None})

        conn.commit()

        print("=" * 40)
        print("DRONE MISSION DISPATCHED")
        print("Event ID:", event_id)
        print("Gate:", gate_number)
        print("Status:", status)
        print("=" * 40)

        return jsonify({
            "mission": f"GATE{gate_number}_TRIGGERED",
            "gate": gate_number,
            "event_id": event_id,
            "status": status,
            "time": event_time
        })

    finally:
        conn.close()


# =========================================================
# PHASE 4 — UPDATE DRONE MISSION STATUS
# =========================================================

@app.route(
    "/drone/mission/<int:event_id>/status",
    methods=["POST"]
)
def update_drone_status(event_id):
    data = request.get_json(silent=True)

    if not isinstance(data, dict):
        return jsonify({
            "error": "Request body must be valid JSON"
        }), 400

    new_status = str(
        data.get("drone_status", "")
    ).upper()

    allowed_statuses = {
        "DISPATCHED",
        "IN_PROGRESS",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
    }

    if new_status not in allowed_statuses:
        return jsonify({
            "error": "Invalid drone_status",
            "allowed": sorted(allowed_statuses)
        }), 400

    conn = get_connection()

    try:
        cursor = conn.execute("""
            UPDATE events
            SET drone_status = ?
            WHERE id = ?
        """, (new_status, event_id))

        conn.commit()

        if cursor.rowcount == 0:
            return jsonify({
                "error": "Event not found",
                "event_id": event_id
            }), 404

        return jsonify({
            "message": "Drone status updated",
            "event_id": event_id,
            "drone_status": new_status
        })

    finally:
        conn.close()


