# =========================================================
# ANDROID APP API — GATE STATUS
# Returns the latest event for each gate.
# =========================================================

@app.route("/api/gates", methods=["GET"])
def api_gates():
    conn = get_connection()

    try:
        rows = conn.execute("""
            SELECT gate, status, time
            FROM events
            ORDER BY id DESC
        """).fetchall()

        latest_by_gate = {}

        for row in rows:
            gate = row["gate"]

            if gate not in latest_by_gate:
                latest_by_gate[gate] = {
                    "gate": gate,
                    "status": row["status"],
                    "timestamp": row["time"]
                }

        return jsonify({
            "success": True,
            "gates": list(latest_by_gate.values())
        })

    finally:
        conn.close()


