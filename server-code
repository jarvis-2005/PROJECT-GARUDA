# PHASE 3 — RECEIVE GATE ALERT
# =========================================================

@app.route("/alert", methods=["POST"])
def receive_alert():
    data = request.get_json(silent=True)

    if not isinstance(data, dict):
        return jsonify({
            "error": "Request body must be valid JSON"
        }), 400

    gate = data.get("gate")
    status = data.get("status")

    if not gate or not status:
        return jsonify({
            "error": "Both gate and status are required"
        }), 400

    gate = str(gate).strip()
    status = str(status).strip()

    current_time = datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )

    conn = get_connection()

    try:
        cursor = conn.cursor()

        cursor.execute("""
            INSERT INTO events (gate, status, time, drone_status)
            VALUES (?, ?, ?, 'PENDING')
        """, (gate, status, current_time))

        event_id = cursor.lastrowid
        conn.commit()

    finally:
        conn.close()

    print("=" * 40)
    print("GATE ALERT RECEIVED")
    print("Event ID:", event_id)
    print("Gate:", gate)
    print("Status:", status)
    print("Time:", current_time)
    print("=" * 40)

    return jsonify({
        "message": "Alert Received",
        "event_id": event_id,
        "gate": gate,
        "status": status,
        "time": current_time
    }), 201


