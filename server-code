# ==============================
# ALERT API
# ==============================

@app.route("/alert", methods=["POST"])
def alert():

    data = request.get_json()

    if not data:
        return jsonify({
            "error": "No JSON data received"
        }), 400

    gate = data.get("gate")
    status = data.get("status")

    if gate is None or status is None:
        return jsonify({
            "error": "gate and status are required"
        }), 400

    # Current time
    current_time = datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )

    # ==========================
    # SAVE EVENT TO SQLITE
    # ==========================

    conn = sqlite3.connect(DATABASE)

    cursor = conn.cursor()

    cursor.execute("""
        INSERT INTO events (gate, status, time)
        VALUES (?, ?, ?)
    """, (gate, status, current_time))

    event_id = cursor.lastrowid

    conn.commit()
    conn.close()

    # ==========================
    # TELEGRAM ALERT
    # ==========================

    message = f"""🚨 GARUDA SECURITY ALERT 🚨

Gate: {gate}
Status: {status}
Time: {current_time}

⚠️ Intrusion detected at Gate {gate}.
"""

    send_telegram_message(message)

    # ==========================
    # SERVER TERMINAL OUTPUT
    # ==========================

    print("\n==============================")
    print("GARUDA SECURITY EVENT")
    print("==============================")
    print("Event ID :", event_id)
    print("Gate     :", gate)
    print("Status   :", status)
    print("Time     :", current_time)
    print("==============================\n")

    return jsonify({
        "message": "Alert received successfully",
        "event_id": event_id,
        "gate": gate,
        "status": status,
        "time": current_time
    })


# ==============================
# VIEW EVENTS
# ==============================

@app.route("/events", methods=["GET"])
def get_events():

    conn = sqlite3.connect(DATABASE)

    cursor = conn.cursor()

    cursor.execute("""
        SELECT id, gate, status, time
        FROM events
        ORDER BY id DESC
    """)

    rows = cursor.fetchall()

    conn.close()

    events = []

    for row in rows:

        events.append({
            "id": row[0],
            "gate": row[1],
            "status": row[2],
            "time": row[3]
        })

    return jsonify(events)


