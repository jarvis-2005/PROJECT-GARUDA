DATABASE = "security.db"


# =========================================================
# DATABASE
# =========================================================

def get_connection():
    conn = sqlite3.connect(DATABASE)
    conn.row_factory = sqlite3.Row
    return conn


def create_database():
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS events (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            gate TEXT,
            status TEXT,
            time TEXT,
            drone_status TEXT DEFAULT 'PENDING'
        )
    """)

    # Support databases created before drone_status existed.
    columns = [
        row["name"]
        for row in cursor.execute(
            "PRAGMA table_info(events)"
        ).fetchall()
    ]

    if "drone_status" not in columns:
        cursor.execute("""
            ALTER TABLE events
            ADD COLUMN drone_status TEXT DEFAULT 'PENDING'
        """)

    conn.commit()
    conn.close()


create_database()


